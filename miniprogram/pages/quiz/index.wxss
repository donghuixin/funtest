.top { display: flex; align-items: center; justify-content: space-between; }
.progress { display: grid; grid-template-columns: repeat(8, 28rpx); gap: 8rpx; }
.cell { width: 28rpx; height: 34rpx; border: 2rpx dashed var(--rule); box-sizing: border-box; }
.cell.on { border: 0; box-shadow: 0 0 0 4rpx var(--white); }
.postcard { position: relative; }
.pm { position: absolute; right: 24rpx; top: -36rpx; width: 128rpx; height: 128rpx; font-size: 18rpx; background: var(--sheet); white-space: pre-line; }
.question { font-size: 46rpx; line-height: 1.5; padding-right: 96rpx; }
.options { display: flex; flex-direction: column; border-top: 2rpx solid var(--rule); }
.option { position: relative; padding: 28rpx 80rpx 28rpx 4rpx; border-bottom: 2rpx solid var(--rule); font-size: 31rpx; line-height: 1.5; }
.option-hover { background: rgba(217,208,193,.25); }
.option.picked { font-weight: 600; }
.chop { position: absolute; right: 8rpx; top: 50%; width: 52rpx; height: 52rpx; margin-top: -26rpx; border: 4rpx solid var(--vermilion); border-radius: 8rpx; color: var(--vermilion); font-family: var(--f-display); font-size: 26rpx; display: flex; align-items: center; justify-content: center; opacity: 0; transform: scale(1.6) rotate(-8deg); box-sizing: border-box; }
.option.picked .chop { opacity: 1; transform: scale(1) rotate(-8deg); transition: transform .12s ease-out, opacity .08s; }
.foot { display: flex; justify-content: space-between; align-items: center; }
.link { color: var(--ink-soft); font-size: 26rpx; text-decoration: underline; }
.slide-in { animation: slideIn .26s ease-out; }
@keyframes slideIn { from { transform: translateX(80rpx); opacity: 0; } to { transform: none; opacity: 1; } }
.stage { flex: 1; min-height: calc(100vh - 220rpx); display: flex; flex-direction: column; justify-content: center; }
.interlude { position: relative; align-items: center; text-align: center; padding: 112rpx 56rpx 64rpx; gap: 0; overflow: hidden; }
.airmail-top { position: absolute; left: 0; right: 0; top: 0; height: 12rpx; background: repeating-linear-gradient(-45deg, #C8452D 0 20rpx, #FFFDF8 20rpx 40rpx, #1F3A5F 40rpx 60rpx, #FFFDF8 60rpx 80rpx); }
.interlude .postmark { white-space: pre-line; }
.postmark.big { width: 200rpx; height: 200rpx; font-size: 26rpx; border-width: 5rpx; letter-spacing: 2rpx; }
.hand { font-family: var(--f-display); font-size: 64rpx; font-weight: 700; letter-spacing: 12rpx; margin-top: 56rpx; }
.i-line { font-size: 30rpx; color: var(--ink-soft); letter-spacing: 2rpx; margin-top: 20rpx; }
.i-progress { display: flex; gap: 10rpx; margin: 72rpx 0 20rpx; }
.i-dot { width: 22rpx; height: 22rpx; border-radius: 50%; border: 2rpx solid var(--rule); box-sizing: border-box; }
.i-dot.on { background: var(--vermilion); border-color: var(--vermilion); }
.i-btn { align-self: stretch; margin-top: 64rpx; }
.sealing { min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 40rpx; }
.closing { transform-origin: top; transform: rotateX(180deg); animation: flapClose .6s .2s ease-in forwards; }
.pop { transform: scale(0); animation: wax .3s .85s ease-out forwards; }
@keyframes flapClose { to { transform: rotateX(0); } }
@keyframes wax { 60% { transform: scale(1.25); } to { transform: scale(1); } }
.ask { font-size: 40rpx; }
.nick { background: var(--white); border: 2rpx solid var(--rule); padding: 24rpx; height: 96rpx; box-sizing: border-box; font-size: 30rpx; }
