/* 方案 A「旧信与邮戳」全局样式 */
page {
  --paper: #F4EFE6;
  --sheet: #FBF8F2;
  --ink: #1F3A5F;
  --ink-soft: #4A5D78;
  --vermilion: #C8452D;
  --brass: #B08A4A;
  --muted: #6B6B6B;
  --rule: #D9D0C1;
  --white: #FFFDF8;
  --f-display: "LetterDisplay", "Songti SC", "STSong", "Noto Serif SC", serif;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}
.wrap { padding: 40rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 32rpx; box-sizing: border-box; min-height: 100vh; }
.display { font-family: var(--f-display); font-weight: 700; }
.muted { color: var(--muted); font-size: 24rpx; }
.label { font-size: 24rpx; color: var(--vermilion); letter-spacing: 4rpx; font-weight: 600; }
.btn { height: 96rpx; padding: 0 32rpx; border-radius: 8rpx; font-size: 30rpx; font-weight: 600; letter-spacing: 4rpx; line-height: 1.3; display: flex; align-items: center; justify-content: center; text-align: center; box-sizing: border-box; }
.btn::after { border: 0; }
.btn-primary { background: var(--ink); color: var(--white); }
.btn-seal { background: var(--vermilion); color: var(--white); }
.btn-ghost { background: var(--white); color: var(--ink); border: 2rpx solid var(--rule); font-weight: 500; }
.btn-sm { height: 80rpx; font-size: 28rpx; letter-spacing: 2rpx; }
.text-link { align-self: center; padding: 12rpx 24rpx; font-size: 26rpx; color: var(--ink-soft); letter-spacing: 2rpx; }
.text-link-hover { opacity: .6; }
.btn-hover { opacity: .85; }
.row { display: flex; gap: 20rpx; }
/* WXSS 不支持通配符 *，改为给子元素加 .col */
.row .col { flex: 1; min-width: 0; }
/* 抵消基础库 button 默认的 184px 宽度和水平 auto 外边距，让按钮撑满容器 */
button.btn { width: auto; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; }
.sheet { background: var(--sheet); border: 2rpx solid var(--rule); padding: 56rpx 44rpx; box-shadow: 0 20rpx 60rpx -40rpx rgba(31,58,95,.6); display: flex; flex-direction: column; gap: 32rpx; }
.postmark { width: 140rpx; height: 140rpx; border: 4rpx solid var(--vermilion); border-radius: 50%; color: var(--vermilion); display: flex; align-items: center; justify-content: center; text-align: center; font-size: 20rpx; line-height: 1.35; transform: rotate(-12deg); font-weight: 600; box-sizing: border-box; }
.para { font-size: 30rpx; line-height: 2; }
.tags { display: flex; gap: 16rpx; flex-wrap: wrap; }
.tag { font-size: 22rpx; line-height: 1.6; padding: 2rpx 18rpx; border-radius: 6rpx; border: 2rpx solid currentColor; letter-spacing: 2rpx; }
/* 分节标题：朱红小字 + 一条细线 */
.section { display: flex; align-items: center; gap: 20rpx; font-size: 24rpx; color: var(--vermilion); letter-spacing: 6rpx; font-weight: 600; margin-top: 16rpx; }
.section::after { content: ""; flex: 1; height: 2rpx; background: var(--rule); }
.disclaimer { font-size: 22rpx; color: var(--muted); text-align: center; }
.seal-env { width: 420rpx; height: 290rpx; background: var(--white); border: 2rpx solid var(--rule); position: relative; margin: 0 auto; overflow: hidden; }
.seal-env .flap { position: absolute; left: 0; right: 0; top: 0; height: 60%; background: var(--sheet); clip-path: polygon(0 0, 100% 0, 50% 100%); border-bottom: 2rpx solid var(--rule); }
.seal-env .wax { position: absolute; left: 50%; top: 60%; width: 84rpx; height: 84rpx; margin: -42rpx 0 0 -42rpx; border-radius: 50%; background: var(--vermilion); color: var(--white); display: flex; align-items: center; justify-content: center; font-family: var(--f-display); font-size: 32rpx; }
.locked { position: relative; }
.locked .blur { filter: blur(10rpx); }
.unlock-card { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; background: linear-gradient(rgba(251,248,242,.3), rgba(251,248,242,.95) 40%); padding: 32rpx; text-align: center; }
.unlock-card .btn { padding: 24rpx 40rpx; }
